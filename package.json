{
  "name": "mockfy-desktop",
  "productName": "Mockfy",
  "version": "1.0.1",
  "description": "Mockfy IELTS practice as a desktop app",
  "main": "main.js",
  "author": "Mockfy",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "uz.mockfy.desktop",
    "productName": "Mockfy",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "titlebar.html", "offline.html", "build/icon.png", "package.json"],
    "protocols": [{ "name": "Mockfy", "schemes": ["mockfy"] }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "Mockfy-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mockfy"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "artifactName": "Mockfy.${ext}",
      "extendInfo": { "NSMicrophoneUsageDescription": "Mockfy records your answers in the Speaking test." }
    },
    "dmg": { "title": "Mockfy" }
  }
}
